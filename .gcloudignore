# Build-context excludes for the Cloud Build upload (gcloud builds submit).
# NOTE: this checkout is a git WORKTREE, so `.git` is a FILE, not a directory —
# exclude it WITHOUT a trailing slash so the pattern actually matches it.
.git
.gitignore
.venv/
.style.yapf
.gcloudignore
.pylintrc

# Deploy-time-only config (sourced by deploy.sh on the build host); the running
# image never reads it, so keep it out of the build context / out of the image.
config.txt

gcs-cors-config.json
firestore.indexes.json

ui/*
!ui/definitions/
# gcloudignore re-applies 'ui/*' to nested path components, so the plain
# '!ui/dist/' re-include loses ui/dist/ui/** (the inner 'ui' re-matches);
# the '**' form is required to keep the built SPA in the upload context.
!ui/dist/
!ui/dist/**
!ui/remix-engine-status-viewer/
test/
tools/
# Host-only tooling and config that the image never COPYs (the Dockerfile copies
# only actions/, actions_lib/, util/, *.py, deployed_version.txt, ui/dist,
# ui/definitions, ui/remix-engine-status-viewer). deploy.sh runs scripts/ and
# deploy/ on the build HOST and seeds creative_templates/ to Firestore from the
# host — none are needed in the uploaded build context. Mirrors .dockerignore.
scripts/
deploy/
creative_templates/
# Docs (incl. the large media gifs) and example workflow inputs are never built
# into or read by the image; only deploy.sh/dev tooling and humans use them.
docs/
workflow_examples/

# Python caches and test/coverage artifacts: never needed in the image, and
# without these the build context uploads them and `COPY . .` bakes them in.
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Dev-only dependency files. The image installs from requirements.txt only
# (Dockerfile), so the dev pins and the pip-compile sources just bloat upload.
requirements-dev.txt
requirements-dev.in

# Node trees and local-only debug logs (the image only needs ui/dist).
node_modules/
firestore-debug.log

# Editor and OS specific
.vscode/
.idea/
.DS_Store
Thumbs.db
