rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production Firestore rules (fully mediated data plane). The UI reads and
    // writes everything through the app service's /api endpoints, which use the
    // Admin SDK and BYPASS these rules. There is no direct client Firestore
    // access at all: the browser does not include the Firestore SDK.

    // Global config is read by the client via GET /api/config (the backend
    // reads the config/global doc with the Admin SDK). The client never reads
    // config/global directly, so no read allowance is granted here — the
    // catch-all below denies it, along with the server-only config/access email
    // allow-list. This matches storage.rules: every collection is mediated.

    // Everything — projects, creativeTemplates, config, all backend-database
    // collections, any other path: no client read or write. The orchestrator's
    // and app service's Admin SDK clients are unaffected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
