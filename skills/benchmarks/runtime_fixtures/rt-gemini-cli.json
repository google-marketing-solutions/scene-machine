{
  "id": "rt-gemini-cli",
  "environment": "Gemini CLI",
  "tier": "2",
  "skill_discovery_dirs": [
    ".gemini/skills/<name>/",
    "~/.gemini/skills/<name>/",
    "gemini skills link <abs dir>"
  ],
  "install_target": "gemini",
  "tools": [
    {
      "name": "run_shell_command",
      "kind": "shell",
      "notes": "asks for user confirmation"
    },
    {
      "name": "write_file",
      "kind": "file_write"
    },
    {
      "name": "replace",
      "kind": "file_write"
    },
    {
      "name": "read_file",
      "kind": "file_read"
    },
    {
      "name": "web_fetch",
      "kind": "web"
    },
    {
      "name": "google_web_search",
      "kind": "web"
    }
  ],
  "filesystem": {
    "writable_roots": [
      "<project>",
      "~"
    ],
    "has_python3": true,
    "has_network": true
  },
  "expected_path": "C",
  "expected_detection_signals": [
    "shell-tool-present",
    "media-tools-absent",
    "agent-transfer-absent"
  ],
  "expected_first_action": "run_shell_command: python3 <SKILL_DIR>/scripts/env_probe.py",
  "blockers": [
    "ffmpeg, Pillow and google-genai must be installed by the user (env_probe.py reports them)",
    "Application Default Credentials and an explicit --project are required for --execute"
  ],
  "verdict": "Works",
  "evidence_urls": [
    "https://geminicli.com/docs/cli/skills/"
  ],
  "notes": "gemini skills list/link/install/enable/disable and /skills reload are the management commands. v2.0.0 verdict was Works-with-fixes."
}
