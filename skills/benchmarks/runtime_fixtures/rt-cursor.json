{
  "id": "rt-cursor",
  "environment": "Cursor",
  "tier": "2",
  "skill_discovery_dirs": [
    ".cursor/skills/<name>/",
    "~/.cursor/skills/<name>/",
    ".agents/skills/",
    ".claude/skills/",
    ".codex/skills/"
  ],
  "install_target": "cursor",
  "tools": [
    {
      "name": "run_terminal_cmd",
      "kind": "shell",
      "notes": "UNVERIFIED exact name"
    },
    {
      "name": "edit_file",
      "kind": "file_write"
    },
    {
      "name": "read_file",
      "kind": "file_read"
    },
    {
      "name": "codebase_search",
      "kind": "other"
    },
    {
      "name": "web_search",
      "kind": "web"
    }
  ],
  "filesystem": {
