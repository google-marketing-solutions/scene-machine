  "blockers": [
    "ffmpeg, Pillow and google-genai must be installed by the user (env_probe.py reports them)",
    "Application Default Credentials and an explicit --project are required for --execute"
  ],
  "verdict": "Works",
  "evidence_urls": [
    "https://cursor.com/docs/context/skills"
  ],
  "notes": "UNVERIFIED: exact shell tool name (run_terminal_cmd). Cursor also reads .agents/skills, .claude/skills and .codex/skills. v2.0.0 verdict was Works-with-fixes."
